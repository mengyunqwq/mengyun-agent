# ============================================================
# 梦云 Agent 环境变量模板
# 用法：把本文件复制成 .env（或直接在系统里设置环境变量）
#   copy .env.example .env
# 注意：.env 已被 .gitignore 忽略，不会进版本库
# ============================================================

# ---------- 模型服务商 ----------
# 支持三种接口协议，用 MYA_API_FORMAT 选（默认 auto，按 baseUrl 自动识别）：
#   openai     /chat/completions     DeepSeek、OpenAI、Ollama、多数中转站
#   anthropic  /v1/messages          Claude 官方、Claude 类中转站
#   gemini     generateContent       Gemini 官方、Gemini 类中转站
# 中转站连不上、报 404/401 时，多半是协议不对，换一个再试。
# MYA_API_FORMAT=auto

# 常用组合示例（取消注释其中一组并填真实值即可）：
# —— 注意：下面每一行示例都默认是**注释状态**。
#    这里曾经踩过大坑：模板里留着没注释的 MYA_API_KEY=sk-在这里填你的key，
#    用户照着「复制 .env.example 成 .env」一跑，占位符就把 config.json 里的
#    真 Key 静默覆盖了，所有请求在发出前就死在请求头编码上
#    （报 "Cannot convert argument to a ByteString"），而且完全看不出原因。

# ── DeepSeek 官方 ──
# MYA_PROVIDER=deepseek
# MYA_API_KEY=sk-在这里填你的key
# MYA_BASE_URL=https://api.deepseek.com/v1
# MYA_MODEL=deepseek-chat
# MYA_API_FORMAT=openai

# ── OpenAI 官方 ──
# MYA_PROVIDER=openai
# MYA_API_KEY=sk-...
# MYA_BASE_URL=https://api.openai.com/v1
# MYA_MODEL=gpt-4o-mini

# ── 本地 Ollama（免 key，先执行 ollama serve）──
# MYA_PROVIDER=ollama
# MYA_BASE_URL=http://127.0.0.1:11434/v1
# MYA_MODEL=qwen2.5-coder:7b

# ── 任意自建/中转网关 ──
# MYA_PROVIDER=custom
# MYA_BASE_URL=https://你的网关/v1
# MYA_API_KEY=...
# MYA_MODEL=...

# ---------- 运行参数 ----------
# 单轮对话里最多允许模型调用多少次工具（防死循环）
# MYA_MAX_TURNS=25
# 采样温度
# MYA_TEMPERATURE=0.3
# 单次请求超时（秒）
# MYA_TIMEOUT=120
# 关闭流式输出（默认开启流式）
# MYA_STREAM=0
# 模型上下文窗口（token）。界面右下角的用量条拿它当分母；
# 留空则按模型名自动推断（DeepSeek / GPT-4o 是 128k，本地小模型 8k）
# MYA_CONTEXT_WINDOW=128000
# 界面语言：zh | en
# MYA_LANG=zh

# ---------- 安全开关 ----------
# 危险：设为 1 时，shell 工具不询问直接执行（适合完全信任的沙箱环境）
# MYA_YES=0
# 危险：设为 1 时，shell 工具走真实系统 shell；为 0 时仅允许白名单安全命令
# MYA_ALLOW_DANGEROUS=0

# ---------- 联网搜索插件（可选） ----------
# Tavily：https://tavily.com
# MYA_TAVILY_KEY=tvly-...

# ---------- 插件市场（可选） ----------
# 不填也能用，但 GitHub 匿名配额较低（搜索 10 次/分钟），
# 且无法按 manifest.json 内容精确搜索。
# 申请地址：https://github.com/settings/tokens （不需要勾任何额外权限）
# 也可以在网页界面的「设置」里填，效果一样。
# GITHUB_TOKEN=ghp_...

# ---------- 网络（连不上 GitHub / 中转站时才需要） ----------
# 走代理。设了它程序会自动打开 Node 的代理开关（NODE_USE_ENV_PROXY）。
# MYA_PROXY=http://127.0.0.1:7890
#
# 本机有中间人证书（公司代理 / 杀软 / 加速器）时，症状是「浏览器能打开、
# 程序报连不上」。优先用下面这个——把根证书导出成 .crt，比关校验安全：
# NODE_EXTRA_CA_CERTS=D:\certs\公司根证书.crt
#
# 实在没办法时临时关掉证书校验。它只解决「证书不被信任」，
# 流量该被中间人看还是被看；程序启动时会为此喊一句警告，用完请删掉这行。
# MYA_INSECURE_TLS=1

# ---------- 排查问题（可选） ----------
# 1 = 打印所有异常堆栈
# MYA_DEBUG=1
# 1 = 打印插件发现与加载过程（插件加载不出来时很有用）
# MYA_DEBUG_DISCOVER=1
